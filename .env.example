# VETJOY Website — environment variable template.
# Copy this file to `.env.local` for local development. Never commit the real
# `.env.local` file (it is already excluded via .gitignore).
#
# The site runs fully in DEMO MODE with no environment variables set — leads
# are held in-memory by src/services/demo-lead-repository.ts. Everything
# below is for the FUTURE Supabase integration described in README.md and is
# not required for Phase 1.

# --- Site ---
# Public base URL used for canonical links, sitemap.xml and Open Graph tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (future — not required for Phase 1 demo mode) ---
# Safe to expose in the browser: anon key is scoped by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_, never import in a "use client"
# file, never log it. Grants full database access, bypassing Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=
